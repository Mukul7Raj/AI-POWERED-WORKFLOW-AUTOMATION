# OpenAI API Configuration (Optional: if empty, built-in mock fallback agent will run automatically)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Database Configuration
# Default is local SQLite (workflow_agent.db). 
# For PostgreSQL, set: postgresql://username:password@localhost:5432/workflow_db
DATABASE_URL=sqlite:///workflow_agent.db
